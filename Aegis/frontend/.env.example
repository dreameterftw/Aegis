# Copy this file to .env.local and fill in your values.
# These are injected at build time by Vite as import.meta.env.*

VITE_WORKER_URL=https://cybersuraksha-worker.workers.dev

# Firebase (client-side — safe to expose)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# FCM Web Push VAPID key (public key from Firebase Console → Project Settings → Cloud Messaging)
VITE_VAPID_KEY=your_vapid_public_key_here
